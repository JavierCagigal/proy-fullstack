# Local: arranca la BD con `npm run db:local` (prisma dev, sin Docker) y usa esta URL en las dos variables.
# Supabase (producción): DATABASE_URL = Transaction pooler (6543) + ?uselibpqcompat=true&sslmode=require
#                        DIRECT_URL   = Session pooler (5432) + ?sslmode=require. Ver docs/despliegue.md
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Clave para firmar los JWT. En producción, una cadena larga y aleatoria (openssl rand -hex 32).
JWT_SECRET="cambia-esto-en-produccion"

# Supabase Storage (subida de archivos): Project Settings → Data API (URL) y API Keys (service_role / secret).
# Bucket privado `recursos` con límite de 20 MB. Ver docs/despliegue.md §7.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# GitHub OAuth (https://github.com/settings/developers). Una OAuth App para local y otra para producción.
# Callback de la app: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# URL de la web (el frontend). Local: http://localhost:5173 · Producción: https://proy-fullstack.vercel.app
APP_URL="http://localhost:5173"

PORT=3000
